# Google Forms Configuration
# These variables are server-side only (do NOT use NEXT_PUBLIC_ prefix)
# Copy this file to .env and fill in the actual values from your Google Form

# The action URL from your Google Form (obtained from the form's HTML)
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLSe9hewGdGxmBGQgJI0Pk7sApMwVvJSC0qZ03amOk2pNbZc-mw/formResponse

# Entry IDs for each field in your Google Form
# These are obtained by inspecting the Google Form HTML and finding the entry.XXXXXX values
GOOGLE_FORM_ACTION_URL=https://docs.google.com/forms/d/e/1FAIpQLSe9hewGdGxmBGQgJI0Pk7sApMwVvJSC0qZ03amOk2pNbZc-mw/formResponse
GOOGLE_FORM_ENTRY_ROLE=entry.632435148
GOOGLE_FORM_ENTRY_FREQUENCY=entry.211844372
GOOGLE_FORM_ENTRY_PROBLEM=entry.1369086326
GOOGLE_FORM_ENTRY_FEATURES=entry.632136989
GOOGLE_FORM_ENTRY_INTEREST=entry.1313332221
GOOGLE_FORM_ENTRY_NAME=entry.1992054636
GOOGLE_FORM_ENTRY_EMAIL=entry.370584087
GOOGLE_FORM_ENTRY_DISCORD=entry.424275036
GOOGLE_FORM_ENTRY_SUGGESTION=

NEXT_PUBLIC_PLAYER_DEMO_URL=http://localhost:8088
NEXT_PUBLIC_ORGANIZER_DEMO_URL=http://localhost:8084

# Demo URLs for interactive previews
# These variables are client-side (use NEXT_PUBLIC_ prefix)
# Development: Use local Docker containers with different ports
# Production: Replace with deployed URLs

NEXT_PUBLIC_PLAYER_DEMO_URL=http://localhost:8088
NEXT_PUBLIC_ORGANIZER_DEMO_URL=http://localhost:8084
